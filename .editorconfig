# Editor settings shared by every contributor.
# Mirrors the WordPress core and Human Made coding standards configuration:
# tabs, LF line endings, UTF-8. https://editorconfig.org

root = true

[*]
charset = utf-8
indent_style = tab
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

# DDEV and GitHub Actions use both extensions; YAML forbids tabs.
[*.{yml,yaml}]
indent_style = space
indent_size = 2

# Two trailing spaces are a Markdown line break.
[*.md]
trim_trailing_whitespace = false
